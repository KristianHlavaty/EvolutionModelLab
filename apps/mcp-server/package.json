{
  "name": "@eml/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Streamable HTTP MCP adapter for Evolution Model Lab.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
